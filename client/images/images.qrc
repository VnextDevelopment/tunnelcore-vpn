        <file alias="controls/eye-off.svg">controls-raster/eye-off.png</file>
        <file alias="controls/eye.svg">controls-raster/eye.png</file>
        <file alias="controls/external-link.svg">controls-raster/external-link.png</file>
        <file alias="controls/file-check-2.svg">controls-raster/file-check-2.png</file>
        <file alias="controls/file-cog-2.svg">controls-raster/file-cog-2.png</file>
