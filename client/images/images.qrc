<RCC>
    <qresource prefix="/">
        <file>../fonts/pt-root-ui_vf.ttf</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="icon.png">../../icon_1.png</file>
        <file>amneziaBigLogo.png</file>
        <file>AmneziaVPN.png</file>
        <!-- Keep the public SVG URLs while serving pre-rasterized transparent
             controls. This avoids Qt 6.10 Android rendering SVG transparency
             as opaque rectangles. -->
        <file alias="controls/alert-circle.svg">controls-raster/alert-circle.png</file>
        <file>update/updateHeroDark.jpg</file>
        <file>update/plus-circle.svg</file>
        <file>update/arrow-up-circle.svg</file>
        <file>update/wrench.svg</file>
        <file alias="controls/amnezia.svg">controls-raster/amnezia.png</file>
        <file alias="controls/app.svg">controls-raster/app.png</file>
        <file alias="controls/archive-restore.svg">controls-raster/archive-restore.png</file>
        <file alias="controls/arrow-left.svg">controls-raster/arrow-left.png</file>
        <file alias="controls/arrow-left-right.svg">controls-raster/arrow-left-right.png</file>
        <file alias="controls/arrow-right.svg">controls-raster/arrow-right.png</file>
        <file alias="controls/bug.svg">controls-raster/bug.png</file>
        <file alias="controls/check.svg">controls-raster/check.png</file>
        <file alias="controls/chevron-down.svg">controls-raster/chevron-down.png</file>
