        <file alias="controls/headphones.svg">controls-raster/headphones.png</file>
        <file alias="controls/help-circle.svg">controls-raster/help-circle.png</file>
        <file alias="controls/history.svg">controls-raster/history.png</file>
        <file alias="controls/home.svg">controls-raster/home.png</file>
        <file alias="controls/infinity.svg">controls-raster/infinity.png</file>
        <file alias="controls/info.svg">controls-raster/info.png</file>
        <file alias="controls/mail.svg">controls-raster/mail.png</file>
        <file alias="controls/map-pin.svg">controls-raster/map-pin.png</file>
